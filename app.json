{
  "expo": {
    "name": "GetSecureVault",
    "slug": "secure-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "securevault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.securevault.opensource",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en"
        ],
        "NSCameraUsageDescription": "GetSecureVault needs camera access to scan QR codes for 2FA setup.",
        "NSFaceIDUsageDescription": "GetSecureVault uses Face ID for secure biometric authentication to protect your cryptocurrency vault.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": false,
        "UIBackgroundModes": [],
        "CFBundleDisplayName": "GetSecureVault",
        "CFBundleShortVersionString": "1.0.0"
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": false,
        "com.apple.developer.networking.networkextension": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.securevault.opensource",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon/foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon/background.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "networkSecurityConfig": {
        "cleartextTrafficPermitted": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "GetSecureVault needs camera access to scan QR codes for 2FA setup."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4f4101aa-36bb-4c2a-9d58-a10771efa243"
      }
    }
  }
}
