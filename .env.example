# SecureVault Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to the repository!

# ================================
# APPLE DEVELOPER CONFIG
# ================================

# Your Apple ID email used for App Store Connect
APPLE_ID_EMAIL=your-apple-id@example.com

# Your Apple Developer Team ID (10 characters)
# Find this in Apple Developer Portal > Membership
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect App ID (numeric)  
# Find this in App Store Connect > Your App > App Information
APP_STORE_CONNECT_APP_ID=123456789

# ================================
# GOOGLE PLAY CONFIG (Future Android)
# ================================

# Path to Google Service Account JSON key
# For Android Play Store submissions
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./path/to/service-account-key.json

# ================================
# BUILD CONFIGURATION
# ================================

# App environment (development, preview, production)
EXPO_PUBLIC_APP_ENV=development

# Enable network monitoring in development
# Set to 'false' for production builds
EXPO_PUBLIC_ALLOW_NETWORK_DEV=true

# Build version numbers
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1

# ================================
# OPTIONAL: CERTIFICATES & KEYS
# ================================

# Apple Distribution Certificate password (if using local certs)
# APPLE_DIST_CERT_PASSWORD=your-cert-password

# Provisioning profile UUIDs (if using specific profiles)  
# IOS_PROVISIONING_PROFILE_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ================================
# SECURITY NOTES
# ================================

# 1. Never commit .env files to version control
# 2. Use different values for development/staging/production
# 3. Rotate credentials regularly
# 4. Use EAS Secrets for cloud builds
# 5. Keep local .env files encrypted or in secure storage
